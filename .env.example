# Optional. An openFDA API key raises the anonymous rate limit.
# Never commit a real key. This file is the template; .env is gitignored.
OPENFDA_API_KEY=

# Required for `pv-mcp http` and Docker Compose. One shared dev bearer token.
# Production would use an OAuth 2.1 access token instead. See docs/adr/0002-authentication.md.
PV_MCP_TOKEN=

# stdio is the default. Set http to serve Streamable HTTP without the http argument.
# PV_MCP_TRANSPORT=stdio
# PV_MCP_HTTP_HOST=127.0.0.1
# PV_MCP_HTTP_PORT=8000
# PV_MCP_RESOURCE_URL=http://127.0.0.1:8000/mcp
# PV_MCP_ISSUER_URL=https://pv-mcp.invalid/dev
# OPENFDA_CACHE_PATH=.cache/openfda.sqlite
# OPENFDA_CACHE_TTL_SECONDS=3600
# PV_MCP_RATE_LIMIT_PER_MINUTE=60
